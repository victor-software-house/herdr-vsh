+    /// HERDR: the upright face slanted, registered once as a font of its own.
+    fn synthetic_italic(&mut self, upright: FontId) -> FontId {
+        if let Some(&slanted) = self.synthetic_italics.get(&upright) {
+            return slanted;
+        }
+        let native = self.fonts[upright.0].native_font();
+        let slanted = unsafe {
+            CTFont::wrap_under_create_rule(CTFontCreateCopyWithAttributes(
+                native.as_concrete_TypeRef(),
+                0.0,
+                &ITALIC_SKEW,
+                std::ptr::null(),
+            ))
+        };
+        let font_id = FontId(self.fonts.len());
+        self.fonts.push(unsafe { FontKitFont::from_native_font(&slanted) });
+        if let Some(name) = self.postscript_names_by_font_id.get(&upright).cloned() {
+            self.postscript_names_by_font_id.insert(font_id, name);
+        }
+        self.synthetic_italics.insert(upright, font_id);
+        font_id
+    }
