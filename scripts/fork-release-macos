#!/bin/bash
# The fork's macOS download: Herdr Fork.app, signed, notarized and stapled, in a zip.
# Built without HERDR_APP_RELEASE: no upstream updates, telemetry or feedback.
# Its own bundle id and app id let it sit beside an installed Herdr.
# Needs the APPLE_CERTIFICATE_* (scripts/mac-sign) and APPLE_API_* secrets.
set -euo pipefail

out=${1:?usage: fork-release-macos output.zip}
: "${APPLE_API_KEY:?missing notary API private key}"
: "${APPLE_API_KEY_ID:?missing notary API key ID}"
: "${APPLE_API_ISSUER:?missing notary API issuer}"
version=$(sed -n 's/^version = "\(.*\)"/\1/p' Cargo.toml | head -1)

cargo build --release --locked

umask 077
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
app="$work/Herdr Fork.app"
mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources"
cp target/release/herdr-app "$app/Contents/MacOS/Herdr"
cp assets/icons/Herdr.icns "$app/Contents/Resources/Herdr.icns"
cp LICENSE THIRD-PARTY-NOTICES "$app/Contents/Resources/"
cat > "$app/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
    <key>CFBundleExecutable</key><string>Herdr</string>
    <key>CFBundleIdentifier</key><string>dev.herdr.app.fork</string>
    <key>CFBundleName</key><string>Herdr Fork</string>
    <key>CFBundleDisplayName</key><string>Herdr Fork</string>
    <key>CFBundleIconFile</key><string>Herdr</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>$version</string>
    <key>CFBundleVersion</key><string>$version</string>
    <key>NSPrincipalClass</key><string>NSApplication</string>
    <key>NSHighResolutionCapable</key><true/>
    <key>LSEnvironment</key><dict>
        <key>HERDR_APP_ID</key><string>herdr-app-fork</string>
    </dict></dict></plist>
PLIST
scripts/mac-sign "$app"

key="$work/notary.p8"
printf '%s' "$APPLE_API_KEY" > "$key"
ditto -c -k --keepParent "$app" "$work/notarize.zip"
xcrun notarytool submit "$work/notarize.zip" --key "$key" --key-id "$APPLE_API_KEY_ID" --issuer "$APPLE_API_ISSUER" --wait --timeout 30m
xcrun stapler staple "$app"
spctl --assess --type execute --verbose=2 "$app"
ditto -c -k --keepParent "$app" "$out"
